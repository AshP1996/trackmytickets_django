# Docker production — copy to .env on the server
# Path-based tenants: https://trackmyticket.luminoai.online/<org>/login

DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Domain
PRIMARY_DOMAIN=trackmyticket.luminoai.online
SITE_URL=https://trackmyticket.luminoai.online
ALLOWED_HOSTS=trackmyticket.luminoai.online,localhost,127.0.0.1,web,nginx
CSRF_TRUSTED_ORIGINS=https://trackmyticket.luminoai.online
CORS_ALLOWED_ORIGINS=https://trackmyticket.luminoai.online
SUPPORT_EMAIL=support@luminoai.online
DEFAULT_FROM_EMAIL=noreply@luminoai.online

# Database
DB_NAME=trackmytickets
DB_USER=ticketuser
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# Server (optional — your VPS public IP for ALLOWED_HOSTS)
SERVER_IP=

# Redis
USE_REDIS=true
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT / encryption (generate unique values)
JWT_SECRET_KEY=
DB_CREDENTIALS_ENCRYPTION_KEY=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
