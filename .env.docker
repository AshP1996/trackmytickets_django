# Docker Environment Variables Template
# Copy this file to .env and fill in your values

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DB_NAME=trackmytickets
DB_USER=ticketuser
DB_PASSWORD=TrackMyTickets2026!
DB_HOST=db
DB_PORT=5432

# Server Configuration
SERVER_IP=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Redis (required for Docker web + Celery)
USE_REDIS=true
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT Configuration
JWT_SECRET_KEY=511bd0176dcf54f2b526242f0be78a4eeee1b349af1b24f6bf02cc56492c480b

# Email Configuration (for OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# SMTP Configuration (alternative names for compatibility)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
