# Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DEBUG=False

# Domain Configuration
DOMAIN=trackmytickets.in
SERVER_IP=your.server.ip.address

# Database Configuration
DB_NAME=ticket_system
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/1

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@trackmytickets.in
ADMIN_EMAIL=admin@trackmytickets.in

# Security
DB_CREDENTIALS_ENCRYPTION_KEY=your-encryption-key-here-generate-with-fernet

# Optional: External Services
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# AWS_ACCESS_KEY_ID=your-aws-key-for-s3-backups
# AWS_SECRET_ACCESS_KEY=your-aws-secret

# Generate SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Generate DB_CREDENTIALS_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
