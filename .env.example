# ─── Django Settings ──────────────────────────────────────────────────
DEBUG=True
DJANGO_SECRET_KEY=           # Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SETTINGS_MODULE=config.settings.dev

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=              # Generate: python -c "import secrets; print(secrets.token_hex(32))"

# ─── Encryption (BYODB credentials) ──────────────────────────────────
DB_CREDENTIALS_ENCRYPTION_KEY=   # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ─── Email / SMTP ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=         # Use a Gmail App Password, NOT your Gmail password
DEFAULT_FROM_EMAIL=

# ─── IMAP (for receiving emails) ─────────────────────────────────────
MAIL_SERVER=imap.gmail.com
MAIL_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Database (production) ───────────────────────────────────────────
DB_NAME=trackmytickets
DB_USER=ticketuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────
USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ─── Server / domain (production) ─────────────────────────────────────
SERVER_IP=localhost
PRIMARY_DOMAIN=trackmyticket.luminoai.online
SITE_URL=https://trackmyticket.luminoai.online
ALLOWED_HOSTS=trackmyticket.luminoai.online,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://trackmyticket.luminoai.online
CORS_ALLOWED_ORIGINS=https://trackmyticket.luminoai.online
SUPPORT_EMAIL=support@luminoai.online
DEFAULT_FROM_EMAIL=noreply@luminoai.online
